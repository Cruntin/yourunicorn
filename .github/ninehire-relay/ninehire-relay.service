[Unit]
Description=Ninehire webhook relay for yourunicorn Recruit page
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ninehire-relay
Group=ninehire-relay
EnvironmentFile=/etc/ninehire-relay.env
ExecStart=/usr/bin/python3 -B /opt/ninehire-relay/relay.py
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
